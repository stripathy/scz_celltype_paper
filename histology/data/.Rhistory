BiocManager::install("apeglm")
install.packages("ashr")
setwd("C:/Users/dwigh/Dropbox/PhD/RNAseq - Cell Specific/Aim 1 (Pitt Cohort)/Cell counting")
cellcounts <- read.csv("full cell counts.csv")
cellcounts$PYR_Avg <- apply(cellcounts[,c("PYR_23", "PYR_56")], 1, mean)
PYR23res <- aov(PYR_23 ~ Subject.Group, data=cellcounts)
PYR56res <- aov(PYR_56 ~ Subject.Group, data=cellcounts)
SSTres <- aov(SST ~ Subject.Group, data=cellcounts)
PVres <- aov(PV ~ Subject.Group, data=cellcounts)
VIPres <- aov(VIP ~ Subject.Group, data=cellcounts)
AllPyrres <- aov(PYR_Avg ~ Subject.Group, data=cellcounts)
cellcounts$Subject.Group <- factor(cellcounts$Subject.Group, levels = c("Control", "MDD", "Bipolar", "SCHIZ"))
#ANOVA results
summary(PYR23res)
summary(PYR56res)
summary(SSTres)
summary(PVres)
summary(VIPres)
summary(AllPyrres)
#post-hoc t-tests (bonferroni)
pairwise.t.test(cellcounts$PV, cellcounts$Subject.Group, p.adjust.method = "bonferroni")
pairwise.t.test(cellcounts$PYR_23, cellcounts$Subject.Group, p.adjust.method = "bonferroni")
pairwise.t.test(cellcounts$PYR_56, cellcounts$Subject.Group, p.adjust.method = "bonferroni")
pairwise.t.test(cellcounts$SST, cellcounts$Subject.Group, p.adjust.method = "bonferroni")
pairwise.t.test(cellcounts$VIP, cellcounts$Subject.Group, p.adjust.method = "bonferroni")
pairwise.t.test(cellcounts$PYR_Avg, cellcounts$Subject.Group, p.adjust.method = "bonferroni")
library(reshape2)
library(ggplot2)
countSummary_Means <- aggregate(. ~ Subject.Group, mean, data=cellcounts)
library(reshape2)
library(ggplot2)
countSummary_Means <- aggregate(. ~ Subject.Group, mean, data=cellcounts)
#########Boxplots
ggplot(cellcounts, aes(x=Subject.Group, y=PYR_23, fill=Subject.Group)) +
geom_boxplot(alpha=0.9) +
scale_y_continuous(expand=c(0,0), limits=c(0,30)) +
ggtitle("L2/3 PYR Cells") +
ylab(label = bquote("Cells / 100,000"~ mu*"M"^2)) +
theme(axis.title.x = element_blank(), legend.position = "none")
ggplot(cellcounts, aes(x=Subject.Group, y=PYR_56, fill=Subject.Group)) +
geom_boxplot(alpha=0.9) +
scale_y_continuous(expand=c(0,0), limits=c(0,30)) +
ggtitle("L5/6 PYR Cells") +
ylab(label = bquote("Cells / 100,000"~ mu*"M"^2)) +
theme(axis.title.x = element_blank(), legend.position = "none")
ggplot(cellcounts, aes(x=Subject.Group, y=PYR_Avg, fill=Subject.Group)) +
geom_boxplot(alpha=0.9) +
scale_y_continuous(expand=c(0,0), limits=c(0,30)) +
ggtitle("Total PYR Cells") +
ylab(label = bquote("Cells / 100,000"~ mu*"M"^2)) +
theme(axis.title.x = element_blank())
#Interneurons
ggplot(cellcounts, aes(x=Subject.Group, y=SST, fill=Subject.Group)) +
geom_boxplot(alpha=0.9) +
scale_y_continuous(expand=c(0,0), limits=c(0,5)) +
ggtitle("SST Cells") +
ylab(label = bquote("Cells / 100,000"~ mu*"M"^2)) +
theme(axis.title.x = element_blank(), legend.position = "none")
ggplot(cellcounts, aes(x=Subject.Group, y=PV, fill=Subject.Group)) +
geom_boxplot(alpha=0.9) +
scale_y_continuous(expand=c(0,0), limits=c(0,2.5)) +
ggtitle("PV Cells") +
ylab(label = bquote("Cells / 100,000"~ mu*"M"^2)) +
theme(axis.title.x = element_blank(), legend.position = "none")
ggplot(cellcounts, aes(x=Subject.Group, y=VIP, fill=Subject.Group)) +
geom_boxplot(alpha=0.9) +
scale_y_continuous(expand=c(0,0), limits=c(0,2.5)) +
