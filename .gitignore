# This monorepo tracks CODE only. Data is wired via symlinks (see
# shared/snrnaseq_de/ and ~/Github/DATA_LAYOUT.md). Each subdir also carries its
# own .gitignore (inherited from its source repo), which governs that subtree.

# snRNA-seq DE interface — symlinked data, never committed
shared/snrnaseq_de/*.csv
shared/snrnaseq_de/*.tsv
shared/snrnaseq_de/nicole_scz_snrnaseq_betas

# cross-component data seams (symlinks -> originals/shared; see DATA_FLOW.md)
transcriptomic/data/*.csv
spatial/output/
spatial/data/nicole_scz_snrnaseq_betas
genetics/data/gwas/*.csv
histology/coordinates

# generic safety net
**/data/*.h5ad
**/*.rds
.DS_Store
__pycache__/
*.pyc

# Fig. 4 panels f/g raw patch-seq data: NWB recordings are large binaries kept
# out of git; the SWC reconstructions are small text and are committed.
# See genetics/data/patchseq/README.md
genetics/data/patchseq/nwb/*.nwb

# Superseded panel-K exploration (5.7 MB). Kept on disk as a methods-provenance
# record of the edgeR-vs-mixed-model comparison and the old exemplar-selection
# rule, but its tables predate the canonical April+PMI DE — one of them flips
# PVALB across p = 0.05. Ignored so `git add -A` cannot sweep it into the repo.
transcriptomic/scratch_panelK/
